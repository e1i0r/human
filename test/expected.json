 "register.toml": {
  "name": "product",
  "label": "A landing for people who will check your claims",
  "voice": "The reader is going to open the repository before they believe anything, so\nevery number has to survive being looked up and every claim has to name the\nthing it is about. Persuasion comes from specificity: the mechanism, in its own\nwords, is more convincing than any sentence about the benefit of the mechanism.\n\nShow what it does rather than what it is for. A feature described by what\nhappens when you press the key beats the same feature described as a capability.\nWhere something is unfinished, say so with its date: a reader who finds the gap\nthemselves stops trusting the rest of the page.\n\nIt sells, and the selling is in the choosing of what to show. No adjective that\nmeasures nothing, no metaphor standing where a mechanism would fit, and no\nclosing line that summarises what the page already proved. The call to action is\nthe repository.\n",
  "watch": [
   "corporate-metaphor",
   "significance",
   "stacked-superlative",
   "aphorism-closer",
   "hedges"
  ]
 }
}
